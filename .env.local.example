NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SERVER ONLY — Never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google OAuth (configured in Supabase dashboard)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AES-256 master key — 32+ random bytes, server-only
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=generate-a-32-byte-hex-string-here

# Blockchain (Hardhat local or EVM-compatible testnet)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
EXAMINATION_REGISTRY_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Bootstrap: first Google login matching this email gets SUPER_ADMIN
# Server-only — never expose with NEXT_PUBLIC_ prefix
INITIAL_ADMIN_EMAIL=your-email@example.com

# Demo mode: if Supabase is not configured, use in-memory demo data
NEXT_PUBLIC_DEMO_MODE=true
