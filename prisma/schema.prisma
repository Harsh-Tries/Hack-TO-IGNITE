datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String
  avatarUrl        String?
  googleId         String?   @unique
  isGoogleVerified Boolean   @default(true)
  role             String    @default("PENDING")
  status           String    @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  collegeId        String?
  college          College?  @relation(fields: [collegeId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime  @default(now())

  examsCreated        Exam[]                 @relation("ExamCreator")
  papersUploaded      QuestionPaper[]        @relation("PaperUploader")
  paperAccesses       PaperAccess[]
  auditLogs           AuditLog[]             @relation("AuditActor")
  centerAssignments   ExamCenterAssignment[] @relation("AssignedBy")
}

model College {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  address      String
  city         String   @default("Pune")
  state        String   @default("Maharashtra")
  postalCode   String   @default("411001")
  contactName  String   @default("Exam Controller")
  contactEmail String
  contactPhone String   @default("+91 20 2437 1101")
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  assignments  ExamCenterAssignment[]
  paperAccess  PaperAccess[]
}

model Exam {
  id              String                @id @default(uuid())
  examCode        String                @unique
  title           String
  description     String?
  academicYear    String                @default("2026-2027")
  semester        String                @default("Semester VI")
  department      String                @default("Computer Engineering")
  subject         String
  examDate        DateTime
  startTime       String                @default("09:00 AM")
  durationMinutes Int                   @default(180)
  paperReleaseTime DateTime
  status          String                @default("DRAFT") // DRAFT, SCHEDULED, PAPER_READY, DISTRIBUTED, RELEASED, COMPLETED, CANCELLED
  createdById     String
  createdBy       User                  @relation("ExamCreator", fields: [createdById], references: [id])
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  questionPapers  QuestionPaper[]
  assignments     ExamCenterAssignment[]
}

model QuestionPaper {
  id                String            @id @default(uuid())
  paperCode         String            @unique
  examId            String
  exam              Exam              @relation(fields: [examId], references: [id])
  subject           String
  originalFilename  String
  encryptedFilePath String?
  sha256Hash        String
  releaseTime       DateTime
  status            String            @default("DRAFT")
  uploaderId        String
  uploader          User              @relation("PaperUploader", fields: [uploaderId], references: [id])
  isRevoked         Boolean           @default(false)
  revocationReason  String?
  revokedAt         DateTime?
  revokedById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  blockchainRecord  BlockchainRecord?
  accessLogs        PaperAccess[]
  signatures        DigitalSignature[]
}

model ExamCenterAssignment {
  id           String   @id @default(uuid())
  examId       String
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  collegeId    String
  college      College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  assignedAt   DateTime @default(now())
  assignedById String?
  assignedBy   User?    @relation("AssignedBy", fields: [assignedById], references: [id])
  status       String   @default("ASSIGNED") // ASSIGNED, REMOVED

  @@unique([examId, collegeId])
}

model AuditLog {
  id             String    @id @default(uuid())
  eventType      String
  entityType     String?
  entityId       String?
  actorId        String?
  actor          User?     @relation("AuditActor", fields: [actorId], references: [id])
  actorEmail     String
  actorRole      String
  targetResource String
  details        String
  metadata       String?
  ipAddress      String    @default("127.0.0.1")
  result         String?
  createdAt      DateTime  @default(now())
}

model SecurityAlert {
  id          String    @id @default(uuid())
  alertType   String
  severity    String    @default("MEDIUM")
  title       String
  description String
  actorEmail  String
  paperId     String?
  examId      String?
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

model BlockchainRecord {
  id            String        @id @default(uuid())
  paperId       String        @unique
  paper         QuestionPaper @relation(fields: [paperId], references: [id])
  paperCode     String
  examId        String
  sha256Hash    String
  issuerAddress String
  txHash        String
  blockNumber   Int
  status        String        @default("CONFIRMED")
  timestamp     DateTime      @default(now())
  createdAt     DateTime      @default(now())
}

model PaperAccess {
  id         String        @id @default(uuid())
  paperId    String
  paper      QuestionPaper @relation(fields: [paperId], references: [id])
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  userRole   String
  collegeId  String?
  college    College?      @relation(fields: [collegeId], references: [id])
  accessTime DateTime      @default(now())
  result     String
  ipAddress  String        @default("127.0.0.1")
}

model DigitalSignature {
  id            String        @id @default(uuid())
  paperId       String        @unique
  paper         QuestionPaper @relation(fields: [paperId], references: [id])
  signerId      String
  signatureHash String
  timestamp     DateTime      @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
